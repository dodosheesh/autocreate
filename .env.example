# --- Base de données / broker ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/autocreate
REDIS_URL=redis://localhost:6379/0

# --- kie.ai ---
KIE_API_KEY=sk-...
KIE_BASE_URL=https://api.kie.ai
# Seedance Fast (720p suffit pour Insta ; Standard = bytedance/seedance-2 pour 1080p)
KIE_SEEDANCE_MODEL=bytedance/seedance-2-fast
# Nano banana Pro + modèle vision (reverse-engineering photo/vidéo)
KIE_NANO_BANANA_MODEL=google/nano-banana-pro
KIE_VISION_MODEL=google/gemini-3-pro
KIE_VISION_BASE_URL=https://api.kie.ai/gemini-3-pro/v1

# URL publique de l'app (Railway) pour les webhooks kie.ai
PUBLIC_BASE_URL=https://mon-app.up.railway.app
# Secret partagé authentifiant les webhooks kie.ai (OBLIGATOIRE en prod)
# générer : python -c "import secrets; print(secrets.token_hex(24))"
KIE_WEBHOOK_SECRET=

# --- Cloudflare R2 (API S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=autocreate
# Base URL publique du bucket (domaine custom ou r2.dev)
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# --- ElevenLabs (voice-swap) ---
ELEVENLABS_API_KEY=
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.75
# VOICE_SWAP_ENABLED=true

# --- QC face-match (nécessite pip install -e ".[qc]") ---
# QC_ENABLED=false
# QC_THRESHOLD=0.35

# --- Auth (Phase 5) ---
# OBLIGATOIRE en prod : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-change-me
BOOTSTRAP_ADMIN_EMAIL=sydeincovind@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login
# Secret partagé pour authentifier les webhooks kie.ai (recommandé en prod)
KIE_WEBHOOK_SECRET=

# --- Auth (OBLIGATOIRE en prod : l'app refuse de démarrer sinon) ---
# Clé de signature des sessions : >= 32 octets aléatoires
# générer : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Compte propriétaire (mot de passe généré aléatoirement si vide, imprimé au init_db)
BOOTSTRAP_ADMIN_EMAIL=sydeincovind@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=
# Forcer le flag Secure du cookie (true si proxy TLS mais PUBLIC_BASE_URL en http)
# SESSION_COOKIE_SECURE=true

# --- Divers ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
